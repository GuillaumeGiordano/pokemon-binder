# --- Database (local: `pnpm db:up`) ---
# Use 127.0.0.1, not localhost: on Windows `pg` may resolve localhost to IPv6 and fail.
DATABASE_URL="postgresql://pokemonbinder:devpassword@127.0.0.1:5434/pokemonbinder?schema=public"

# --- « Se connecter avec G2 Hub » (OpenID Connect) ---
# The application created in the hub console (offer Auth); return URL: <POKEMON_BINDER_URL>/auth/callback
HUB_URL="http://localhost:5180"
POKEMON_BINDER_URL="http://localhost:5200"
POKEMON_BINDER_CLIENT_ID=""
POKEMON_BINDER_CLIENT_SECRET=""

# --- Session (signed cookie) ---
# 32 characters minimum: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
